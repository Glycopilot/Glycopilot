# Copy this file to terraform.tfvars.plan-plus before testing Plan Plus on the
# current source account. Do not commit the copied file.

aws_region       = "eu-west-3"
instance_type    = "t3.micro"
data_bucket_name = "glycopilot-aws-s3-bucket-img-artifacts"

enable_rds                  = true
rds_identifier              = "glycopilot-postgres"
rds_database_name           = "glycopilot_prod_db"
rds_master_username         = "glycopilot_prod_user"
rds_instance_class          = "db.t4g.micro"
rds_allocated_storage       = 20
rds_backup_retention_period = 1
rds_multi_az                = false
rds_deletion_protection     = true

# First apply should stay dormant: resources exist, but no running task yet.
enable_plan_plus        = true
plan_plus_desired_count = 0

# Use the same published images currently deployed by Plan A unless a newer
# stable tag is intentionally selected.
  plan_plus_backend_image    = "ghcr.io/<org>/<repo>/<backend-image>:<tag>"
  plan_plus_ai_service_image = "ghcr.io/<org>/<repo>/<ai-image>:<tag>"

plan_plus_allowed_hosts        = "*"
plan_plus_cors_allowed_origins = ""
plan_plus_csrf_trusted_origins = ""

# Required before enable_plan_plus=true can be planned/applied.
plan_plus_backend_secret_key_value_from = "arn:aws:secretsmanager:eu-west-3:<account-id>:secret:<backend-secret>"
plan_plus_db_password_value_from        = "arn:aws:secretsmanager:eu-west-3:<account-id>:secret:<rds-secret>:password::"
plan_plus_ai_internal_token_value_from  = "arn:aws:secretsmanager:eu-west-3:<account-id>:secret:<ai-token-secret>"

# Optional. Required only if the registry image cannot be pulled publicly by ECS.
# The secret value must contain registry username/password fields accepted by ECS.
plan_plus_repository_credentials_value_from = ""
