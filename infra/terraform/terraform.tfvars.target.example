# Copy this file outside source control before using it for the target account.
# Keep Plan Plus disabled for the first target-account apply.

aws_region       = "eu-west-3"
instance_type    = "t3.micro"
data_bucket_name = "glycopilot-target-data-bucket"
frontend_bucket_name = "glycopilot-target-web-frontend"
landing_bucket_name  = "glycopilot-fr-landing"

enable_frontend_cloudfront              = true
frontend_cloudfront_aliases             = ["www.glycopilot.tech"]
frontend_cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:<account-id>:certificate/<frontend-certificate-id>"

enable_frontend_web_ci_deploy_policy = true
frontend_web_ci_deploy_user_name     = "github_action"

enable_landing_cloudfront              = true
landing_cloudfront_aliases             = ["glycopilot.fr", "www.glycopilot.fr"]
landing_cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:<account-id>:certificate/<landing-certificate-id>"

enable_landing_ci_deploy_policy = true
landing_ci_deploy_user_name     = "github_action"

# SSH target account.
# Generate a target-only key locally and never commit the private key:
# ssh-keygen -t ed25519 -f infra/ssh/glycopilot_target_deploy_key -C "glycopilot-target-deploy"
# ssh_public_key can either be pasted here from the .pub file or passed with -var.
ssh_public_key       = ""
ssh_private_key_path = "infra/ssh/glycopilot_target_deploy_key"

enable_observability_dashboard = false

enable_rds                  = true
rds_identifier              = "glycopilot-postgres"
rds_database_name           = "glycopilot_prod_db"
rds_master_username         = "glycopilot_prod_user"
rds_instance_class          = "db.t4g.micro"
rds_allocated_storage       = 20
rds_backup_retention_period = 1
rds_multi_az                = false
rds_deletion_protection     = true

# Plan Plus stays dormant until the target Plan A runtime is restored and tested.
enable_plan_plus        = false
plan_plus_desired_count = 0

# Required only when enable_plan_plus=true.
plan_plus_backend_image                  = ""
plan_plus_ai_service_image               = ""
plan_plus_alb_certificate_arn            = "arn:aws:acm:eu-west-3:<account-id>:certificate/<api-admin-certificate-id>"
plan_plus_allowed_hosts                  = "api.glycopilot.tech,admin.glycopilot.tech"
plan_plus_cors_allowed_origins           = "https://www.glycopilot.tech"
plan_plus_csrf_trusted_origins           = "https://www.glycopilot.tech,https://admin.glycopilot.tech"
plan_plus_backend_secret_key_value_from     = ""
plan_plus_db_password_value_from            = ""
plan_plus_ai_internal_token_value_from      = ""
plan_plus_repository_credentials_value_from = ""
