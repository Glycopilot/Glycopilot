{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8006/api",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8006"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.glycopilot.tech/api",
        "EXPO_PUBLIC_WS_URL": "wss://api.glycopilot.tech/ws"
      }
    },
    "apk": {
      "environment": "production",
      "developmentClient": false,
      "distribution": "internal",
      "channel": "apk",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.glycopilot.tech/api",
        "EXPO_PUBLIC_WS_URL": "wss://api.glycopilot.tech/ws",
        "EXPO_PUBLIC_S3_BUCKET": "glycopilot-target-data-bucket"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.glycopilot.tech/api",
        "EXPO_PUBLIC_WS_URL": "wss://api.glycopilot.tech/ws"
      }
    }
  }
}
